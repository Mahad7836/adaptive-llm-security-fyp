GROQ_API_KEY=your_groq_api_key_here

OPENAI_COMPATIBLE_BASE_URL=https://api.groq.com/openai/v1
OPENAI_COMPATIBLE_API_KEY=your_groq_api_key_here

GROQ_MODEL=openai/gpt-oss-120b

CRYPTOFIREWALL_SECRET_KEY=your_secret_key_here

# QA Robustness Auditing Logging Toggle (True / False)
AUDIT_DEBUG=True

# Optional override for baseline synthetic injection payload
# BASELINE_INJECTION_PAYLOAD="<INFORMATION>...</INFORMATION>"

# SwarmSec probe attempts per scenario before stopping (default 12)
SWARMSEC_MAX_RETRIES=12

# Bandit exploration weight for SwarmSec UCB1 routing (lower = exploit sooner; default 0.5)
SWARMSEC_UCB_C=0.5
